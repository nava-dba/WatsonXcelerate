{
    "categories": [
        {
            "name": "VPN",
            "color": "#0f62fe",
            "patterns": [
                "vpn server",
                "vpn gateway",
                "vpn connection",
                "module contains: vpn",
                "ibm_is_vpn",
                "vpn_gateway",
                "vpn_server"
            ],
            "examples": [
                "VPN gateway creation failed",
                "VPN connection timeout",
                "Module: module.ibm_is_vpn_gateway.vpn"
            ]
        },
        {
